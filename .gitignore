# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# liboqs source is NOT vendored — it's cloned/built per SETUP.md
liboqs/
*.dll
*.so

# Data & large artifacts
data/
!src/data/
*.tar.gz
*.zip
# deliverable bundles under paper/ are tracked despite the *.zip rule
!paper/*.zip

# Results: keep csv/plots, ignore bulky logs/checkpoints
results/**/*.log
results/**/*.pt
results/**/checkpoints/

# Run logs, heartbeats, and scratch (not source)
*.err
results/hb_*.txt
results/figs/_shot_*.png

# Derived page/slide PNG renders (not source)
paper/full_png/
paper/method_png/
paper/slides_png/
paper/slide*.png

# Env
.venv/
.env

# LaTeX build artifacts (keep .tex/.pdf/.bib/.md)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Private: writing-system reference pack and source PDFs (do NOT publish)
jahin_publication_system/

# derived Overleaf working copy (the zip is committed instead)
paper/overleaf/

# Office lock/temp files
~$*
**/~$*
